# DMS control-plane image. Used, unmodified, for all of: `dms migrate`,
# `dms api`, `dms controller` (see deploy/k8s/30-migrate-job.yaml,
# 40-api.yaml, 41-controller.yaml) -- the entrypoint is the dms CLI, k8s
# picks the subcommand via `command:`.
#
# Build (context = repo root):
#   podman build -f deploy/docker/Dockerfile.dms -t pkg-01:5000/dms:<tag> .

# --- web build stage ---
# Builds the portal SPA (frontend/) independently of, and before, the python
# runtime stage below. Only its /web/dist output is copied forward -- node
# and the frontend toolchain never end up in the final image.
FROM node:20-bookworm-slim AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json* /web/
RUN npm ci || npm install
COPY frontend/ /web/
RUN npm run build

# Pin bookworm: bare python:3.11-slim now resolves to Debian trixie. Nothing
# here needs OpenMPI, but keeping the whole image set on one Debian release
# avoids surprise apt/glibc drift (the agent image is FROM this one and copies
# the bookworm-built mpifileutils tree onto it).
FROM python:3.11-slim-bookworm

# Match the testbed's pinned cluster version (see CLAUDE.md: K8s 1.34.6).
ARG KUBECTL_VERSION=v1.34.6

ENV PYTHONUNBUFFERED=1 \
    HOME=/home/dms

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && curl -fsSLo /usr/local/bin/kubectl \
        "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
    && chmod 0755 /usr/local/bin/kubectl \
    && addgroup --system --gid 65532 dms \
    && adduser --system --uid 65532 --ingroup dms --home /home/dms dms \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml /app/
COPY src /app/src

# 배포 매니페스트 동봉(슬라이스 16 설계 §2.1): api 가 manifest_tags.py 로 이 사본을
# 읽어 라이브 워크로드 이미지와 비교한다(드리프트 배지). 이 사본은 "이 이미지를 만든
# 소스 트리의 매니페스트"라 의미가 정확하다 -- 포탈 롤아웃은 매니페스트를 고치지
# 않으므로 롤아웃 직후에는 반드시 불일치가 표시된다(의도된 동작). dms 패키지는 pip
# install 로 site-packages 에 들어가므로 경로는 /app/deploy/k8s 고정이다(manifest_tags
# 의 _ROOT_CANDIDATES 둘째 후보).
COPY deploy/k8s /app/deploy/k8s

# Portal SPA build output (built in the "web" stage above from frontend/).
# api/app.py create_app() serves it as static files + SPA fallback when
# DMS_STATIC_DIR points at a dist dir (see Task 1).
COPY --from=web /web/dist /app/static
ENV DMS_STATIC_DIR=/app/static

# postgres: psycopg driver for DMS_DATABASE_URL (db.py Database.connect).
# ldap: ldap3 for the LDAP identity resolver (identity_ldap.py).
# kubernetes: python kubernetes client for the Volcano execution adapter
#   (execution_volcano.py KubernetesClient, in-cluster config).
RUN pip install --no-cache-dir '.[postgres,ldap,kubernetes]'

USER 65532:65532
ENTRYPOINT ["dms"]
