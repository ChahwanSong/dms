# DMS node-agent image = the dms image (dms package + kubectl) PLUS the
# mpifileutils tool binaries layered onto PATH, so the agent's tool probe
# (shutil.which() in src/dms/agent/probes.py::probe_tools) reports
# dscan/dsync/nsync/drm as "Ready". The agent itself never RUNS the mpi
# tools (Volcano job pods do that, via the dms-mpifileutils image) -- it
# only needs the binaries present to probe them, plus `<tool> --version`
# to be invocable (probe_tools shells out for the version line), so no MPI
# runtime env is required here beyond what's already on the binaries' PATH.
#
# Build (context = repo root; both build args are already-built/pushed images -- normally done for you by
# deploy/docker/build-and-push.sh or the portal build, deploy/README §1·§8):
#   podman build -f deploy/docker/Dockerfile.agent \
#     --build-arg DMS_IMAGE=<REGISTRY>/dms:<DMS_TAG> \
#     --build-arg MFU_IMAGE=<REGISTRY>/dms-mpifileutils:<DMS_TAG> \
#     -t <REGISTRY>/dms-agent:<DMS_TAG> .
# No defaults (2026-11-06, fail-closed): the old defaults named the testbed registry, so a build without --build-arg
# silently layered onto another site's images. Empty args make FROM fail loudly instead.
ARG DMS_IMAGE
ARG MFU_IMAGE

FROM ${MFU_IMAGE} AS mfu

FROM ${DMS_IMAGE}
COPY --from=mfu /opt/mpifileutils /opt/mpifileutils
ENV PATH=/opt/mpifileutils/bin:${PATH} \
    LD_LIBRARY_PATH=/opt/mpifileutils/lib

# Stays root: a node agent is inherently privileged (host mounts, host-root probes). The dms base image runs as
# USER 65532 with ENTRYPOINT ["dms"]; the DaemonSet also sets runAsUser 0 and command `dms agent`.
# (2026-10-26 dms-k8s LDAP removal: no nslcd / libnss-ldapd / nsswitch / agent-entrypoint.sh -- every job runs as
#  root, so the agent no longer resolves user identities on the node.)
USER root
ENTRYPOINT ["dms"]
CMD ["agent"]
