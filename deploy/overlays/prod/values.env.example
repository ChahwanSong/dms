# DMS 프로덕션 설치 값 — 이 파일 하나만 채우면 된다(2026-08-30).
# 렌더러(sh deploy/render.sh prod — 옛 overlays/prod/render.sh 는 같은 일을 하는 호환 진입점)가 이 값들을 overlays/prod 템플릿
# (kustomization·patch-*)과 플랫폼 층(deploy/platform — PriorityClass·클러스터 내 레지스트리·DB·입구)에 넣어 deploy/.rendered/prod/ 를 만든다
# (2026-11-03 ④⑤⑥). 채운 뒤: `sh deploy/install.sh --context <ctx> --plan` 으로 먼저 검증하고(변경 없음), 통과하면
# `sh deploy/install.sh --context <ctx>`(S4 뒤 멈춤 → 인터넷 노드 push → `--stage S5` 로 재개 — 2026-11-03 ⑦, overlays/prod/README.md).
#
# 비밀은 여기 두지 않는다 — DB/토큰/세션 비밀(dms-pg-app·dms-secrets 4키)은 설치기 S2 가 클러스터에 만든다(deploy/pg-secrets.py —
# 값을 출력하지 않는다). TLS(PORTAL_TLS_SECRET)만 사이트가 만든다. 이 파일은 비밀이 아닌
# 사이트 설정만 담는다(그래도 git 에는 커밋하지 말 것 — 채운 값은 사이트 고유).
#
# 값에 파이프(|)만 쓰지 않으면 된다(sed 구분자). 콤마·슬래시·콜론 다 괜찮다. SHARED_DIR 는 더 좁은 문자 규칙이 있다(아래).
#
# dms-k8s 브랜치: k8s 신원 모드 전용(2026-10-26 LDAP 코드 삭제) — LDAP_*·IDENTITY_SUPPLEMENTARY_GROUPS 키가 없다(옛 values.env 에
# 남아 있어도 무시된다).
# 권한은 k8s RoleBinding 맵핑(k8s 신원 모드)이고, 대상 클러스터·호출 노드·StorageClass 매핑은 설치 뒤 포탈의
# 「k8s 연동」 화면에서 등록한다(deploy/README.md §6-5 — 그 전에 메일(Knox 릴레이)부터, §6-2).

# --- 이미지 레지스트리(2026-11-03 ④, 설계 v6 7 — deploy/README.md §2e) ---
# in-cluster(권장): DMS 가 control-plane 노드에 띄우는 레지스트리(deploy/platform/registry — Distribution v3.1.2, 1개, 평문 HTTP·익명,
#   저장소 <SHARED_DIR>/dms/registry). 주소 = <REGISTRY_CLUSTER_IP>:<REGISTRY_PORT>(고정 ClusterIP) — 이 주소가 REGISTRY·이미지 newName·
#   DMS_JOB_IMAGE·DMS_BUILD_REGISTRY·DMS_BUILD_BUILDER_IMAGE 와 DB 의 잡 이미지에 박히는 계약이라 한 번 정하면 바꾸지 않는다(7-4). 노드
#   준비(S0-4 신뢰 drop-in·S0-5 레지스트리 이미지 반입·고정)와 S4(적용)·S5(push)·S6(pull 확인)는 deploy/README.md §2e.
# external: 사이트가 운영하는 레지스트리(REGISTRY 에 host:port) — 옛 values.env 와 같다(REGISTRY_MODE 줄이 없으면 external 로 본다).
REGISTRY_MODE=in-cluster
REGISTRY_CLUSTER_IP=REPLACE_REGISTRY_CLUSTER_IP   # 예: 10.96.0.50 — ServiceCIDR 안·미사용·하단 정적 대역. 렌더러는 IPv4 형식만 본다 —
                                       #   나머지는 S1 preflight 가 본다(2026-11-03 ⑦) — 손으로는: 대역 `kubectl --context <ctx> get servicecidr`,
                                       #   미사용 `kubectl --context <ctx> get ipaddresses.networking.k8s.io <IP>` 가 NotFound, 하단 정적 대역 =
                                       #   CIDR 의 처음 min(max(16, 주소 수/16), 256)개(/12 면 x.x.0.0~x.x.0.255 — 동적 할당이 이 대역을 마지막에 쓴다)
REGISTRY_PORT=5000
REGISTRY=                               # external: 레지스트리 host:port(경로 접두 불가)   예: registry.corp.example:5000
                                       #   in-cluster: 비워 두면 <REGISTRY_CLUSTER_IP>:<REGISTRY_PORT> — 채우면 그 값과 같아야 한다
REGISTRY_TLS_VERIFY=false               # in-cluster 는 평문 HTTP 라 false 만. external TLS 레지스트리면 true — 인터넷 노드 push(--dest-tls-verify true)·
                                       #   설치기 S5 대조(https)만 쓴다. 포탈 태그 조회·삭제·빌드 push 는 http:// 고정이라 TLS 레지스트리에서는
                                       #   쓰지 못한다(설계 7-2, 2026-11-03 ⑦ 리뷰 2). 빈 값 = false
SHARED_DIR_ID=REPLACE_SHARED_DIR_ID     # in-cluster: S0(sh deploy/shared-dir-init.sh <SHARED_DIR>)가 쓴 <SHARED_DIR>/dms/.dms-shared-id 값
                                       #   (S0 출력의 「dms/.dms-shared-id = …」). 레지스트리 init 이 저장소의 센티널(.dms-registry-id)과
                                       #   대조해 다르거나 없으면 기동하지 않는다(마운트 빠진 마스터의 로컬 디스크에 쓰지 않게, 7-3)
# REGISTRY_CPU_REQUEST=100m              # (선택) 레지스트리 requests — 기본 100m/128Mi(limits 1/512Mi, 설계 2-1). 실측으로 보정
# REGISTRY_MEMORY_REQUEST=128Mi
# 태그 3종: 첫 설치는 실제 push 한 명시 태그를 셋 다 같게(부트스트랩 build-and-push.sh 가 한 TAG 로 셋을 빌드한다 — agent 는 같은
# TAG 의 dms·dms-mpifileutils 위에서 빌드된다). 설치 뒤로는 `live` 로 둘 수 있다 --
# render.sh 가 지금 클러스터에서 도는 태그를 읽어 채우므로(--context 필요), 포탈로 빌드·릴리스한 뒤 이 파일을
# 안 고쳐도 재-apply(설정 변경 등)가 라이브를 되돌리지 않는다(가드 통과). 포탈 릴리스는 values.env
# 를 읽지 않으니 평소엔 이 파일을 손댈 일이 없고, `live` 는 그 한 번의 재-apply 수작업도 없앤다.
# 이미지를 values.env 로 올리고 싶을 때만 명시 태그로 바꾼다(라이브와 다르면 가드 exit 3 — ALLOW_IMAGE_CHANGE=1 로 의도를 밝힌다).
# 태그 이름은 사이트가 정한다 — 아래 「예: d118」은 이 저장소 테스트베드 계열(dN)의 모양일 뿐이다(deploy/README §4·§9).
DMS_TAG=REPLACE_DMS_TAG                 # dms(api·controller) 태그   예: d118  또는  live
DMS_AGENT_TAG=REPLACE_DMS_AGENT_TAG     # dms-agent 태그   예: d118  또는  live
MFU_TAG=REPLACE_MFU_TAG                 # dms-mpifileutils(잡 러너) 태그   예: d118  또는  live
SHARED_DIR=REPLACE_SHARED_DIR           # 공용 디렉터리(절대 경로)   예: /srv/dms_shared  (→ file:///srv/dms_shared/dms/artifacts)
                                       #   사이트가 **모든 마스터·워커의 같은 호스트 경로**에 /etc/fstab 으로 미리 마운트한 공용
                                       #   스토리지(종류 무관)의 마운트포인트 또는 그 아래. DMS 는 마운트·프로비저닝하지 않고
                                       #   <SHARED_DIR>/dms/{artifacts,...} 만 쓴다(S0: sh deploy/shared-dir-init.sh <값>). api/controller hostPath·
                                       #   아티팩트 base·allowlist 가 전부 <SHARED_DIR>/dms/artifacts 다(2026-11-03, 설계 v6 3-1·3-2).
                                       #   형식: 절대 경로, '/' 아님, 정규화(// · /./ · /../ · 끝 / 없음), 문자 ^/[A-Za-z0-9._/-]+$
                                       #   확인: python3 deploy/shared-storage-probe.py --context <ctx> --shared-dir <값> --image <dms 이미지>
                                       #   옛 SHARED_FS(상대 이름, 예: cephfs)는 없어졌다 — 남아 있으면 render.sh 가 FAIL 하고
                                       #   SHARED_DIR=/<옛 값> 으로 바꾸라고 알린다. <SHARED_DIR>/dms 와 그 상위·하위는 DMS 스토리지로
                                       #   등록할 수 없다(포탈 422 storage_overlaps_dms_state).
# 아래 넷(EMAIL_DOMAIN·LOCAL_ADMIN·PORTAL_DOMAIN·PORTAL_VIP)은 렌더가 「비었나·자리표시자 그대로인가」만 본다 — 형식(도메인·계정명·
# IPv4)은 검사하지 않으니 오타에 주의한다: LOCAL_ADMIN 이 틀리면 첫 관리자(S13 에서 그 이름으로 만드는 계정)가 특권 목록 밖(일반
# 관리자)이 되고, PORTAL_DOMAIN·PORTAL_VIP 가 틀리면 인증서 SAN·S12 의 VIP 경유 검증이 어긋난다(render.sh KEYS — deploy/README §0-1).
EMAIL_DOMAIN=REPLACE_EMAIL_DOMAIN       # 계정 셀프서비스 이메일 도메인   예: corp.example
                                       #   (계정 아이디 = k8s 맵핑 ID — 인증 메일이 그 결속을 보증한다)
LOCAL_ADMIN=REPLACE_LOCAL_ADMIN         # 로컬 운영자 계정명(특권 목록 — 전체 PV·직접 경로 권한)
PORTAL_DOMAIN=REPLACE_PORTAL_DOMAIN     # 포탈 FQDN(사내 DNS → Avi VIP-A, U5)   예: dms.corp.example
PORTAL_VIP=REPLACE_PORTAL_VIP           # Avi VS-443 의 VIP-A(사이트 LB 가 소유 — DMS 는 이 주소를 광고하지 않는다)   예: 203.0.113.10
                                       #   둘 다 매니페스트에는 들어가지 않는다(2026-11-03 ⑥ — Gateway 리스너는 hostname 이 없고 MetalLB 가 없다).
                                       #   render.env 로만 가서 인증서 SAN(FQDN + VIP-A, 보안 S3)과 S12 `curl --resolve <FQDN>:443:<VIP-A>` 의 기준이 된다.

# --- 입구(Envoy Gateway, 2026-11-03 ⑥, 설계 v6 #13·#14·4-3 — deploy/README.md §2g) ---
# 렌더러가 deploy/.rendered/prod/{addons/gateway-api,addons/envoy-gateway,platform/gateway} 를 낸다(늘 — prod 의 유일한 입구; 앱 오버레이는
# Ingress·MetalLB 풀을 지운다). 버전·이미지 digest 는 deploy/versions.env·deploy/images.lock(Gateway API v1.6.1 standard · EG v1.9.3 · Envoy
# distroless-v1.39.5). 노드 전제: 마스터 3대 /etc/sysctl.d/90-dms-envoy.conf 의 net.ipv4.ip_unprivileged_port_start = 443(S0-5). 아래는 전부 선택:
# GATEWAY_PROXY_PROTOCOL=required        # required(기본 — Avi VS-443 의 PROXY v2 헤더 없는 연결을 끊는다) | optional(**컷오버 중에만** — §2g)
#                                       #   | off(LB 가 PROXY v2 를 **못 붙이는** 사이트의 상시 모드 — Envoy 가 PROXY 를 해석하지 않는다. 기록되는 원 IP 는
#                                       #   LB(SE) 주소이고 앱 출발지 경보를 끈다. optional 을 상시로 쓰지 않는다 — 클라이언트가 PROXY 헤더를 심어 기록을 위조할 수 있다. §2g-4)
# GATEWAY_LISTEN_PORT=10443              # Envoy 가 마스터 호스트에서 여는 포트 = LB 풀 멤버 포트(VS 는 그대로 VIP:443). 기본 443. 마스터의 호스트 443 을 다른 것이
#                                       #   쓰는 클러스터용(예: RKE2 Traefik 의 hostPort 443 — S1·S8 이 찾아 멈춘다). 1024 이상이면 마스터 sysctl(S0-5)이 필요 없다.
#                                       #   NodePort 범위(30000~32767)·32768 이상은 피한다. 확인: 마스터에서 ss -ltnH '( sport = :10443 )' 가 빈 출력(§2g-4)
# PORTAL_TLS_SECRET=dms-portal-tls       # Gateway 인증서 Secret(ns dms, kubernetes.io/tls — SAN = PORTAL_DOMAIN + PORTAL_VIP)
# GATEWAY_ENVOY_CPU_REQUEST=100m         # Envoy requests(limits 1/2Gi — 설계 2-1)
# GATEWAY_ENVOY_MEMORY_REQUEST=256Mi

# --- DB(CloudNativePG, 2026-11-03 ⑤, 설계 v6 6 — deploy/README.md §2f) ---
# 렌더러가 deploy/.rendered/prod/{addons/cnpg,platform/db-volumes,db-cluster,db-backup,db-probe} 를 낸다(늘 — PG 는 늘 공용 경로 PV, 로컬 디스크
# 선택지 없음). 버전·이미지 digest 는 여기가 아니라 커밋된 deploy/versions.env·deploy/images.lock 이 원천이다(CNPG 1.30.1·PG 17). 이미지는
# 클러스터 내 레지스트리(in-cluster)에서 받는다 — S5 가 lock 의 cloudnative-pg·postgresql 을 push 한다(external 이면 REGISTRY 로 — §2f-3). 아래는 전부 선택(기본 = 설계 값):
# PG_STORAGE_SIZE=20Gi                  # Cluster storage.size == PV capacity(한 값 — 명목값, hostPath 는 강제하지 않는다). PV 를 만든 뒤에는 바꾸지 않는다(SSA 가 PV 용량을 조용히 바꿔 Cluster 와 어긋난다 — S10 pv-check 가 FAIL)
# PG_CPU_REQUEST=1                      # PG 인스턴스 CPU requests(limit 없음 — 설계 2-1)
# PG_MEMORY=4Gi                         # 메모리 requests == limits
# PG_SHARED_BUFFERS=1GB                 # PG 단위(kB·MB·GB). 기본 = PG_MEMORY/4(PG_MEMORY 만 바꾸면 따라간다 — 메모리 limit 안에서 채워지므로 절반 이상이면 렌더 FAIL).
#                                       #   imageName 과 한 번에 바꾸지 않는다(switchover 모드 — §2f-6; PG_MEMORY 를 바꿔도 이 값이 같이 바뀐다)
# PG_PLACEMENT=control-plane            # 마스터마다 1개(#27). all-nodes 는 control-plane 이 하나뿐인 테스트베드 전용 — prod 에 쓰지 않는다
# CONTROL_PLANE_LABEL_VALUE=true        # control-plane 노드 라벨 node-role.kubernetes.io/control-plane 의 값. 비우면 ""(kubeadm 관례 — base 그대로).
#                                       #   RKE2 는 "true" — 그대로면 레지스트리·PG·Envoy·api/controller 가 Pending. 확인: kubectl get nodes -L node-role.kubernetes.io/control-plane
# PG_BACKUP_KEEP=336                    # pg_dump 보존 개수(매시간 → 336 = 14일)
