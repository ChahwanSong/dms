# DMS 프로덕션 설치 값 — 이 파일 하나만 채우면 된다(2026-08-30).
# render.sh 가 이 값들을 overlays/prod 템플릿(kustomization·patch-*)에 넣어
# ../.prod-rendered/ 를 만든다. 채운 뒤: `sh deploy/install.sh --dry-run` 으로
# 먼저 검증하고, 통과하면 `sh deploy/install.sh`.
#
# 비밀은 여기 두지 않는다 — DB/토큰/세션 비밀은 dms-secrets(4키)로
# out-of-band 주입한다(overlays/prod/README.md §Secret). 이 파일은 비밀이 아닌
# 사이트 설정만 담는다(그래도 git 에는 커밋하지 말 것 — 채운 값은 사이트 고유).
#
# 값에 파이프(|)만 쓰지 않으면 된다(sed 구분자). 콤마·슬래시·콜론 다 괜찮다.
#
# dms-k8s 브랜치(2026-10-25): LDAP 을 쓰지 않는다 — LDAP_* 키가 없다(옛 values.env 에 남아 있어도 무시된다).
# 권한은 k8s RoleBinding 맵핑(k8s 신원 모드)이고, 대상 클러스터·호출 노드·StorageClass 매핑은 설치 뒤 포탈의
# 「k8s 연동」 화면에서 등록한다(deploy/README.md 런북).

REGISTRY=REPLACE_REGISTRY               # 사내 레지스트리 host:port   예: registry.corp.example
REGISTRY_TLS_VERIFY=true                # 평문 HTTP 레지스트리면 false (install.sh 의 push 단계 podman --tls-verify)
# 태그 3종: 첫 설치는 실제 push 한 명시 태그(예: d118). 설치 뒤로는 `live` 로 둘 수 있다 --
# render.sh 가 지금 클러스터에서 도는 태그를 읽어 채우므로, 포탈로 빌드·릴리스한 뒤 이 파일을
# 안 고쳐도 재-apply(설정 변경 등)가 라이브를 되돌리지 않는다(가드 통과). 포탈 릴리스는 values.env
# 를 읽지 않으니 평소엔 이 파일을 손댈 일이 없고, `live` 는 그 한 번의 재-apply 수작업도 없앤다.
# install.sh 로 이미지를 직접 올리고 싶을 때만 명시 태그로 바꾼다.
DMS_TAG=REPLACE_DMS_TAG                 # dms(api·controller) 태그   예: d118  또는  live
DMS_AGENT_TAG=REPLACE_DMS_AGENT_TAG     # dms-agent 태그   예: d118  또는  live
MFU_TAG=REPLACE_MFU_TAG                 # dms-mpifileutils(잡 러너) 태그   예: d118  또는  live
SHARED_FS=REPLACE_SHARED_FS            # 공유 FS 마운트 최상위   예: cephfs  (→ file:///cephfs/dms/artifacts)
                                       #   주의: 40/41 의 hostPath 는 /cephfs 고정이라 현재는 cephfs 만 유효
                                       #   (다른 값이면 allowlist·base 가 파드에 안 보이는 경로를 가리킨다)
EMAIL_DOMAIN=REPLACE_EMAIL_DOMAIN       # 계정 셀프서비스 이메일 도메인   예: corp.example
                                       #   (계정 아이디 = k8s 맵핑 ID — 인증 메일이 그 결속을 보증한다)
LOCAL_ADMIN=REPLACE_LOCAL_ADMIN         # 로컬 운영자 계정명(특권 목록 — 전체 PV·직접 경로 권한)
PORTAL_DOMAIN=REPLACE_PORTAL_DOMAIN     # 포탈 도메인   예: dms.corp.example
PORTAL_VIP=REPLACE_PORTAL_VIP           # 공인 서비스 VIP   예: 203.0.113.10

# --- 선택 키(없으면 기본값으로 렌더 -- 예전 values.env 도 그대로 쓸 수 있다) ---
# 보조 그룹(LDAP posixGroup gidNumber) 인정 스위치(2026-10-07): true|false 만(그 밖의 값은 render 실패).
# dms-k8s(k8s 신원 모드)에서는 효과가 없다(모든 잡이 root) — 옛 values.env 호환으로만 남긴다.
# 비상 끄기용이다 -- false 로 렌더·apply 한 뒤 `kubectl -n dms rollout restart deploy/dms-controller`.
# **계획 시점 전용**이라 이미 계획된 잡은 스냅숏대로 끝나고, 같이 들어간 fail-closed(LDAP 중복 엔트리·
# 비특권 주 gid 0 거부·artifact base g+w/ACL/o+x 판정 등)는 이 스위치로 꺼지지 않는다 -- deploy/README §2c 표.
IDENTITY_SUPPLEMENTARY_GROUPS=true
