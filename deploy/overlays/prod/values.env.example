# DMS 프로덕션 설치 값 — 이 파일 하나만 채우면 된다(2026-08-30).
# render.sh 가 이 값들을 overlays/prod 템플릿(kustomization·patch-*)에 넣어
# ../.prod-rendered/ 를 만든다. 채운 뒤: `sh deploy/install.sh --dry-run` 으로
# 먼저 검증하고, 통과하면 `sh deploy/install.sh`.
#
# 비밀은 여기 두지 않는다 — DB/토큰/세션/LDAP 비밀번호는 dms-secrets 로
# out-of-band 주입한다(overlays/prod/README.md §Secret). 이 파일은 비밀이 아닌
# 사이트 설정만 담는다(그래도 git 에는 커밋하지 말 것 — 채운 값은 사이트 고유).
#
# 값에 파이프(|)만 쓰지 않으면 된다(sed 구분자). 콤마·슬래시·콜론 다 괜찮다.

REGISTRY=REPLACE_REGISTRY               # 사내 레지스트리 host:port   예: registry.corp.example
DMS_TAG=REPLACE_DMS_TAG                 # dms 이미지 태그(실제 push 한 것)   예: d118
DMS_AGENT_TAG=REPLACE_DMS_AGENT_TAG     # dms-agent 태그   예: d118
MFU_TAG=REPLACE_MFU_TAG                 # dms-mpifileutils(잡 러너) 태그   예: d118
SHARED_FS=REPLACE_SHARED_FS            # 공유 FS 마운트 최상위   예: cephfs  (→ file:///cephfs/dms/artifacts)
LDAP_HOST=REPLACE_LDAP_HOST            # 사내 LDAP host   예: ldap.corp.example
                                       #   (URI 콤마 목록·페일오버가 필요하면 렌더 후
                                       #    .prod-rendered/patch-config.yaml 의 DMS_LDAP_URI 를 직접 편집)
LDAP_USER_BASE=REPLACE_LDAP_USER_BASE   # 예: ou=People,dc=corp,dc=example
LDAP_GROUP_BASE=REPLACE_LDAP_GROUP_BASE # 예: ou=Groups,dc=corp,dc=example
LDAP_BIND_DN=REPLACE_LDAP_BIND_DN       # 검색 계정 DN(비밀 아님)  예: uid=search_sc,ou=user,ou=ldap_user,dc=corp,dc=example
                                       #   (비밀번호는 dms-secrets 의 DMS_LDAP_BIND_PW)
EMAIL_DOMAIN=REPLACE_EMAIL_DOMAIN       # 계정 셀프서비스 이메일 도메인   예: corp.example
LOCAL_ADMIN=REPLACE_LOCAL_ADMIN         # 로컬 운영자 계정명(LDAP 밖, 특권 실행 경로)
PORTAL_DOMAIN=REPLACE_PORTAL_DOMAIN     # 포탈 도메인   예: dms.corp.example
PORTAL_VIP=REPLACE_PORTAL_VIP           # 공인 서비스 VIP   예: 203.0.113.10
