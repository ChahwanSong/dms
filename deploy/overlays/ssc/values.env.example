# DMS SSC 설치 값 — 이 파일 하나만 채운다(2026-08-30, 웹 노드 hostNetwork 엣지).
# 사용:  cp values.env.example values.env  후 채우고  sh deploy/overlays/ssc/install.sh
#
# prod(MetalLB) 대비 차이: PORTAL_VIP 가 없다. public IP 는 MetalLB VIP 가 아니라
# 웹 노드 호스트 NIC 에 직접 설정된 IP 이고, 어떤 매니페스트에도 템플릿되지 않는다
# (노출은 ingress-nginx hostNetwork 가 한다). 대신 아래 두 값을 쓴다:
#   WEB_NODE          : public IP 가 있는 노드 이름 -- install.sh 가 라벨을 붙이고
#                       ingress-nginx 가 이 노드에 고정됐는지 검증한다.
#   PORTAL_PUBLIC_IP  : 그 public IP -- verify.sh 가 접속 검증에 쓰고, TLS 인증서
#                       (dms-portal-tls) SAN 에 반드시 포함돼야 한다.
# 비밀은 여기 두지 않는다 — DB/토큰/세션/LDAP PW 는 dms-secrets(out-of-band, README).

REGISTRY=REPLACE_REGISTRY               # 사내 레지스트리 host:port   예: registry.ssc.example
DMS_TAG=REPLACE_DMS_TAG                 # dms 이미지 태그(실제 push 한 것)
DMS_AGENT_TAG=REPLACE_DMS_AGENT_TAG     # dms-agent 태그
MFU_TAG=REPLACE_MFU_TAG                 # dms-mpifileutils(잡 러너) 태그
SHARED_FS=REPLACE_SHARED_FS            # 공유 FS 마운트 최상위   예: cephfs
LDAP_HOST=REPLACE_LDAP_HOST            # 사내 LDAP host
LDAP_USER_BASE=REPLACE_LDAP_USER_BASE   # 예: ou=People,dc=ssc,dc=example
LDAP_GROUP_BASE=REPLACE_LDAP_GROUP_BASE # 예: ou=Groups,dc=ssc,dc=example
LDAP_BIND_DN=REPLACE_LDAP_BIND_DN       # 검색 계정 DN(비밀 아님)
EMAIL_DOMAIN=REPLACE_EMAIL_DOMAIN       # 계정 이메일 도메인
LOCAL_ADMIN=REPLACE_LOCAL_ADMIN         # 로컬 운영자 계정명(LDAP 밖)
PORTAL_DOMAIN=REPLACE_PORTAL_DOMAIN     # 포탈 도메인   예: dms.ssc.example (IP 직접 접속만 쓰면 임의 값 가능)

# --- 엣지(hostNetwork) 전용 -- 매니페스트에 템플릿되지 않고 install/verify 가 읽는다 ---
WEB_NODE=REPLACE_WEB_NODE               # public IP 가 있는 노드 이름   예: ssc-web1
PORTAL_PUBLIC_IP=REPLACE_PORTAL_PUBLIC_IP  # 그 노드의 public IP   예: 203.0.113.10  (TLS SAN 에 포함할 것)
