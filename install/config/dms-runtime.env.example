# 값을 Kubernetes Secret/ConfigMap으로 옮겨서 사용한다. 실제 secret은 commit하지 않는다.

DMS_DATABASE_URL=postgresql://dms_app:CHANGE_ME@postgres.example.internal:5432/dms
DMS_OBSERVABILITY_DATABASE_URL=postgresql://dms_obs:CHANGE_ME@postgres.example.internal:5432/dms_observability
DMS_AUTH_SHARED_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN
DMS_DEFAULT_ACTOR=
DMS_REQUIRE_MTLS_HEADER=true
DMS_REQUIRE_MTLS_VERIFIED_HEADER=true
DMS_MTLS_ACTOR_PREFIX=mtls:

DMS_WORKER_LEASE_SECONDS=300
DMS_PREVIEW_TTL_SECONDS=86400
DMS_AGENT_REPORT_STALE_SECONDS=300
DMS_CONTROL_CLUSTER_NAME=cluster-a

DMS_KUBERNETES_INVENTORY_MODE=kubectl
DMS_KUBERNETES_MUTATION_MODE=kubectl
DMS_CLUSTER_KUBECONFIGS_JSON={"cluster-a":"/etc/dms/kubeconfigs/cluster-a.kubeconfig","cluster-b":"/etc/dms/kubeconfigs/cluster-b.kubeconfig"}
DMS_CLUSTER_CONTROL_HOSTS_JSON=
DMS_KUBERNETES_INVENTORY_TIMEOUT_SECONDS=10
DMS_KUBERNETES_MUTATION_TIMEOUT_SECONDS=30

DMS_FILESYSTEM_MUTATION_MODE=ssh-host-exec
DMS_FILESYSTEM_EXEC_TIMEOUT_SECONDS=300
DMS_FILESYSTEM_EXEC_USE_SUDO=true

DMS_DM_NAMESPACE=dms
DMS_DM_JOB_IMAGE=registry.example.internal/dms-mpifileutils:CHANGE_ME
DMS_DM_JOB_IMAGE_REF=CHANGE_ME_MPIFILEUTILS_GIT_REF
DMS_DM_SERVICE_ACCOUNT=dms-dm-worker
DMS_DM_ARTIFACT_BASE_URI=file:///artifacts/dms
DMS_DM_DEFAULT_PRIORITY=Mid
DMS_DM_DEFAULT_MAX_NODES=1
DMS_DM_MAX_NODES=1
DMS_DM_POLICY_DEFAULT_WORKER_NODES=3
DMS_DM_POLICY_MAX_WORKER_NODES=3
DMS_DM_POLICY_DEFAULT_PROCESSES_PER_NODE=3
DMS_DM_POLICY_MAX_PROCESSES_PER_NODE=10
DMS_DM_POLICY_DEFAULT_QUEUE=dms-data
DMS_DM_POLICY_DEFAULT_PRIORITY_CLASS=dms-normal
DMS_DM_SCHEDULER_BACKEND=auto
DMS_DM_SCAN_TIMEOUT_SECONDS=3600
DMS_DM_SYNC_PREVIEW_TIMEOUT_SECONDS=1800
DMS_DM_SYNC_EXECUTION_TIMEOUT_SECONDS=3600
DMS_DM_RM_PREVIEW_TIMEOUT_SECONDS=1800
DMS_DM_RM_EXECUTION_TIMEOUT_SECONDS=3600
DMS_DM_CONFIRM_REQUIRE_PREVIEW_FINGERPRINT=true
DMS_DM_SYNC_ALLOW_DELETE=false
DMS_DM_MAX_SYNC_NODES=1
DMS_DM_MAX_RM_NODES=1
DMS_DM_NSYNC_ENABLED=true
DMS_DM_NSYNC_SERVICE_PREFIX=dms-nsync
DMS_DM_MONITOR_POLL_SECONDS=5
DMS_DM_JOB_DELETE_ON_TERMINAL=false
DMS_DM_KUBERNETES_MODE=cluster

DMS_LDAP_URI=ldap://ldap.example.internal:389
DMS_LDAP_BASE_DN=dc=example,dc=internal
DMS_LDAP_BIND_DN=cn=dms,ou=service-accounts,dc=example,dc=internal
DMS_LDAP_BIND_PASSWORD=CHANGE_ME
DMS_LDAP_USER_SEARCH_BASE=ou=people,dc=example,dc=internal
DMS_LDAP_GROUP_SEARCH_BASE=ou=groups,dc=example,dc=internal
DMS_LDAP_USER_FILTER=(uid={username})
DMS_LDAP_TIMEOUT_SECONDS=5
DMS_LDAP_GROUP_GID_START=24000
DMS_LDAP_GROUP_GID_END=24999
