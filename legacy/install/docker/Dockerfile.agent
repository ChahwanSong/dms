# DMS DM-agent image = the DMS image (dms package + kubectl + agent probes,
# incl. os_metrics) PLUS the mpifileutils tool binaries on PATH so the agent's
# tool probe (shutil.which) reports dsync/dscan/etc. "Ready". The agent does NOT
# run the MPI tools itself (the DM worker's Volcano pods do), so no MPI runtime
# is needed here — only the binaries on PATH, matching the prior dm-agent image.
#
# Build (context = repo root; both args are existing pushed images):
#   docker build -f install/docker/Dockerfile.agent \
#     --build-arg DMS_IMAGE=pkg-01:5000/dms:<tag> \
#     --build-arg MFU_IMAGE=pkg-01:5000/dms-agent:<prev-mfu-tag> \
#     -t pkg-01:5000/dms-agent:<tag> .
ARG DMS_IMAGE=pkg-01:5000/dms:latest
ARG MFU_IMAGE=pkg-01:5000/dms-agent:latest

FROM ${MFU_IMAGE} AS mfu

FROM ${DMS_IMAGE}
COPY --from=mfu /opt/mpifileutils /opt/mpifileutils
ENV PATH=/opt/mpifileutils/bin:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/sbin:/bin
ENV LD_LIBRARY_PATH=/opt/mpifileutils/lib
