{
  "_comment": "hot 비율 규칙의 공용 예제(2026-10-19) -- 포탈 usageStats.hotRatio 와 서버 dms.usage_metrics.hot_ratio(목록 정렬)가 같은 값을 내는지 양쪽 테스트가 이 파일로 검증한다. expected null = 모름.",
  "hot_age_max_days": 180,
  "cases": [
    { "name": "empty", "buckets": [], "expected": null },
    { "name": "all_hot",
      "buckets": [{ "min_age_days": 0, "max_age_days": 1, "bytes": 30 }, { "min_age_days": 1, "max_age_days": 2, "bytes": 70 }],
      "expected": 1 },
    { "name": "boundary_180_is_hot_181_is_cold",
      "buckets": [{ "min_age_days": 91, "max_age_days": 180, "bytes": 100 },
                  { "min_age_days": 181, "max_age_days": 365, "bytes": 300 }],
      "expected": 0.25 },
    { "name": "open_ended_last_bucket_is_known_cold",
      "buckets": [{ "min_age_days": 0, "max_age_days": 7, "bytes": 100 },
                  { "min_age_days": 3651, "bytes": 100 }],
      "expected": 0.5 },
    { "name": "open_bucket_below_boundary_is_unknown",
      "buckets": [{ "min_age_days": 0, "max_age_days": 7, "bytes": 100 }, { "min_age_days": 30, "bytes": 5 }],
      "expected": null },
    { "name": "open_bucket_without_bytes_is_ignored",
      "buckets": [{ "min_age_days": 0, "max_age_days": 7, "bytes": 40 }, { "min_age_days": 30, "bytes": 0 }],
      "expected": 1 },
    { "name": "missing_bytes_is_unknown",
      "buckets": [{ "min_age_days": 0, "max_age_days": 7, "bytes": 40 }, { "min_age_days": 7, "max_age_days": 30 }],
      "expected": null },
    { "name": "bool_bytes_is_unknown",
      "buckets": [{ "min_age_days": 0, "max_age_days": 7, "bytes": true }],
      "expected": null },
    { "name": "all_zero_is_unknown",
      "buckets": [{ "min_age_days": 0, "max_age_days": 7, "bytes": 0 }, { "min_age_days": 200, "max_age_days": 400, "bytes": 0 }],
      "expected": null },
    { "name": "all_cold",
      "buckets": [{ "min_age_days": 181, "max_age_days": 365, "bytes": 10 }],
      "expected": 0 }
  ]
}
